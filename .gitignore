# Ignore IDEs folders...
.idea/
# Ignore files by extension...
*.iso
*.log
# Ignore locks, bin, envs...
composer
composer.lock


### @Bootgly ###

## Global folders
# Excluded
**/&

## Root folders
# Boot
@/*
vendor
# Legacy: installs made before the vendor-dir was standardised
@imports
!@/autoboot.php

!@/__php__/
!@/__docker__/

## Private files
# Examples
_*.example.php
# Tests
_*.Test.php


#-- /Bootgly --#
# ...

#-- resource dirs --#
# The kit is a delivery vehicle: the user never commits to it, and everything
# the tooling writes at its root is machine state. Ignoring the resource dirs
# whole is what keeps `git status` clean and `git pull` conflict-free.

#- /docs
# Ignore user docs (project specs, notes)
/docs/

#- /projects
# Ignore user projects — each one is its own git repository
/projects/

#- /public
# Ignore leftover kit-level public dirs (assets are per project — the serving
# APIs are jailed to the project directory)
/public/

#- /scripts
# Ignore operational scripts copied by `bootgly kit boot`
/scripts/

#- /storage
# Ignore runtime data (logs, pids, cache, ...)
/storage/

#- /tests
# Ignore leftover kit-level test dirs (tests are per project now)
/tests/
